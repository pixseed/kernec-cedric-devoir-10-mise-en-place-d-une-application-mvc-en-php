  },
  "homepage": "https://github.com/pixseed/kernec-cedric-devoir-10-mise-en-place-d-une-application-mvc-en-php#readme",
  "dependencies": {
    "bootstrap": "^5.3.8",
    "sass": "^1.102.0"
  },
  "devDependencies": {
    "copyfiles": "^2.4.1"
  }
